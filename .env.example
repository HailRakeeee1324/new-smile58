# Яндекс Метрика уже встроена в код проекта напрямую.
# Текущий ID счётчика:
VITE_YANDEX_METRIKA_ID=109447302

# Если позже захотите снова использовать переменные окружения,
# можно вернуть чтение import.meta.env.VITE_YANDEX_METRIKA_ID в src/main.jsx.

# Куда отправлять заявки формы записи (Vercel → Project Settings → Environment Variables)
# Вариант 1: Telegram-бот
TELEGRAM_BOT_TOKEN=123456789:PASTE_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_CHAT_ID_HERE

# Вариант 2: любой внешний webhook/CRM (необязательно)
LEADS_WEBHOOK_URL=https://example.com/webhook

# Канонический домен для sitemap.xml / robots.txt / canonical при сборке
# Если домен будет другим — замените перед деплоем.
PUBLIC_SITE_URL=https://new-smile58.ru

# Yandex SmartCaptcha для защиты формы записи
# Ключ клиента нужен во фронтенде Vite, поэтому начинается с VITE_
VITE_YANDEX_SMARTCAPTCHA_CLIENT_KEY=PASTE_CLIENT_KEY_HERE
# Ключ сервера хранится только на стороне Vercel Function
YANDEX_SMARTCAPTCHA_SERVER_KEY=PASTE_SERVER_KEY_HERE
